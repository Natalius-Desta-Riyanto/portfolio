---
import Icon from './Icon.astro';
import {t,type Locale} from '../data/site';
interface Props{locale:Locale;}
const {locale}=Astro.props;const c=t(locale);
---
<section class="experience-section"><div class="section-heading"><div><div class="eyebrow">02 / {c.sampleExperience}</div><h2>{c.experienceTitle}</h2></div><p>{c.sampleNotice}</p></div><div class="experience-grid"><div class="company-experience"><div class="company-heading"><span class="company-monogram" aria-hidden="true">T.</span><div><h3>TNEX</h3><p>Kota Damansara, Selangor, Malaysia · Remote</p></div></div><div class="timeline">{[[c.engineeringRole,c.engineeringDate,c.engineeringText],[c.internRole,c.internDate,c.internText]].map(([role,date,text],index)=><article><span class="timeline-dot" aria-hidden="true"></span><div class="micro">{date}</div><h3>{role}</h3><p>{text}</p><details class="role-details"><summary>{c.workDetails}<Icon name="chevron"/></summary><ul>{(index===0?c.engineeringTasks:c.internTasks).map(task=><li>{task}</li>)}</ul></details></article>)}</div></div><div class="toolkit"><div class="eyebrow">{c.toolkit}</div><h3>{c.discipline}</h3><div class="toolkit-group"><span class="micro">{c.engineering}</span><ul class="stack">{['React','TypeScript','Supabase','PostgreSQL','OpenAI','n8n'].map(s=><li>{s}</li>)}</ul></div><div class="toolkit-group"><span class="micro">{c.analysis}</span><ul class="stack">{['Python','SQL','pandas','Data visualization'].map(s=><li>{s}</li>)}</ul></div></div></div></section>
