---
import Icon from './Icon.astro';
import {t,type Locale} from '../data/site';
interface Props{locale:Locale;}
const {locale}=Astro.props;const c=t(locale);
---
<section class="experience-section"><div class="experience-grid"><div class="company-experience"><div class="company-heading"><span class="organization-logo tnex-logo"><img src={`${import.meta.env.BASE_URL}brands/tnex.png`} alt="T-NEX" width="147" height="35" loading="lazy"/></span><div><h2 class="company-name">T-NEX</h2><p>Kota Damansara, Selangor, Malaysia · Remote</p><div class="company-websites"><a href="https://t-nex.de/en/">t-nex.de/en</a></div></div></div><div class="timeline">{[[c.engineeringRole,c.engineeringDate,c.engineeringText],[c.internRole,c.internDate,c.internText]].map(([role,date,text],index)=><article><span class="timeline-dot" aria-hidden="true"></span><div class="micro">{date}</div><h2>{role}</h2><p>{text}</p><details class="role-details"><summary><span><Icon name="briefcase"/>{c.workDetails}</span><span class="role-count">{index===0?'04':'03'}<Icon name="chevron"/></span></summary><div class="role-work-grid">{(index===0?c.engineeringTaskTitles:c.internTaskTitles).map((task,i)=><div class="role-work-card"><span class="work-number">{String(i+1).padStart(2,'0')}</span><div><h3>{task}</h3><p>{(index===0?c.engineeringTaskDescriptions:c.internTaskDescriptions)[i]}</p></div></div>)}</div></details></article>)}</div></div></div></section>
