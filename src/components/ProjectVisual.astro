---
interface Props {slug:string;title:string;image:string;}
const {slug,title,image}=Astro.props;
const analytical=slug==='lendsight';
---
<span class:list={['project-visual',{'project-visual-data':analytical}]} aria-hidden="true">
 <span class="visual-topline"><span>{analytical?'PORTFOLIO INTELLIGENCE':'RECONCILIATION WORKSPACE'}</span><span>0{analytical?'2':'1'} ↗</span></span>
 <span class="visual-title">{title}<span>{analytical?'Data, with context.':'Every record, accounted for.'}</span></span>
 <span class="visual-window"><span class="visual-window-bar"><i></i><i></i><i></i><span>{analytical?'Portfolio / Overview':'Workspace / Batches'}</span></span><img src={`${import.meta.env.BASE_URL}${image}`} alt="" width="1440" height="1500" loading="lazy"/></span>
 <span class="visual-detail"><img src={`${import.meta.env.BASE_URL}${image}`} alt="" width="1440" height="1500" loading="lazy"/></span>
 <span class="visual-bottom"><span>{analytical?'OBSERVED / SIMULATION':'IMPORT / MATCH / REVIEW'}</span><span>{analytical?'Python · SQL · React':'Next.js · PostgreSQL'}</span></span>
</span>
