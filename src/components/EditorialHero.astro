---
import {href,t,type Locale} from '../data/site';
import {editorial} from '../data/editorial';
import Icon from './Icon.astro';
import StudioIllustration from './StudioIllustration.astro';
import CvAction from './CvAction.astro';
const practiceLabels={en:['Build','Analyze'],id:['Membangun','Menganalisis'],ja:['開発','分析'],de:['Entwickeln','Analysieren'],zh:['开发','分析']};
const {locale}=Astro.props as {locale:Locale};const c=t(locale),e=editorial(locale);
---
<section id="intro" class="editorial-hero container">
 <div class="hero-identity"><span>Natalius Desta Riyanto</span><span class="micro">{e.role}</span></div>
 <div class="editorial-hero-grid">
  <div class="editorial-hero-copy"><div class="eyebrow">SOFTWARE / DATA / MATHEMATICS</div><h1>{e.headline[0]}<span>{e.headline[1]}</span></h1></div><div class="hero-introduction"><StudioIllustration/><p class="lead">{e.intro}</p><div class="actions"><a class="button" href={`${href(locale)}#projects`}><Icon name="grid"/>{c.viewProjects}</a><a class="text-link" href={`${href(locale)}#contact`}><Icon name="mail"/>{c.contact}</a></div></div>

 </div>
 <div class="practice-strip" aria-label={e.capabilities}><a href={`${href(locale)}#capabilities`}><span class="practice-glyph"><Icon name="code"/></span><span><strong>{practiceLabels[locale][0]}</strong><small>React · TypeScript · FastAPI · PostgreSQL</small></span><span class="practice-project">Padun / Sakuara</span></a><a href={`${href(locale)}#projects`}><span class="practice-glyph"><Icon name="grid"/></span><span><strong>{practiceLabels[locale][1]}</strong><small>Python · SQL · Statistics</small></span><span class="practice-project">LendSight / Stockwise</span></a></div>
 <div class="hero-bottom"><span>{c.basedIn} {c.location}</span><CvAction locale={locale}/><a href={`${href(locale)}#projects`}>{e.indexLabel}</a></div>
</section>
