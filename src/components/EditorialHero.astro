---
import {href,t,type Locale} from '../data/site';
import {editorial} from '../data/editorial';
import {profileAssets} from '../data/profile';
import Icon from './Icon.astro';
import CvAction from './CvAction.astro';
const {locale}=Astro.props as {locale:Locale};
const c=t(locale),e=editorial(locale);
const home=href(locale);
---
<section id="intro" class="hero container">
 <div class="hero-grid">
  <div class="hero-copy">
   <p class="badge badge-status"><span class="status-dot" aria-hidden="true"></span>{c.engineeringRole} · T-NEX</p>
   <h1>{e.headline[0]} <span>{e.headline[1]}</span></h1>
   <p class="lead">{e.intro}</p>
   <div class="actions">
    <a class="btn btn-primary btn-lg" href={`${home}#projects`}>{c.viewProjects}<Icon name="right"/></a>
    <CvAction locale={locale} size="lg"/>
   </div>
   <p class="hero-meta"><Icon name="pin"/>{c.location}<span aria-hidden="true">·</span>UTC+7</p>
  </div>
  {profileAssets.photo&&<figure class="hero-portrait">
   <img src={`${import.meta.env.BASE_URL}${profileAssets.photo}`} alt="Natalius Desta Riyanto" width="640" height="800" loading="eager" fetchpriority="high"/>
   <figcaption><strong>Natalius Desta Riyanto</strong><span>{c.profileRole}</span></figcaption>
  </figure>}
 </div>
</section>
