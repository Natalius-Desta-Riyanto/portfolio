---
interface Props {name:string;class?:string;}
const {name,class:className=''}=Astro.props;
const paths:Record<string,string>={
grid:'<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>',arrow:'<path d="M7 17 17 7M7 7h10v10"/>',left:'<path d="m14 6-6 6 6 6M8 12h12"/>',right:'<path d="m10 6 6 6-6 6M4 12h12"/>',download:'<path d="M12 3v12m-5-5 5 5 5-5M4 16v4h16v-4"/>',mail:'<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>',pin:'<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',menu:'<path d="M4 7h16M4 12h12M4 17h16"/>',chevron:'<path d="m6 9 6 6 6-6"/>',theme:'<circle cx="12" cy="12" r="8"/><path d="M12 4v16"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/>',play:'<path d="m9 5 11 7-11 7Z"/>',pause:'<path d="M9 5v14M15 5v14"/>',globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/>',linkedin:'<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M7 10v7M11 17v-7m0 3a3 3 0 0 1 6 0v4"/><circle cx="7" cy="7" r=".8" fill="currentColor"/>',github:'<path d="M9 20c-4 1-4-2-6-2m12 4v-4c0-1 .2-1.7-1-2 4-.5 6-2 6-6 0-1.4-.5-2.5-1.3-3.4.1-1 .2-2-.4-3.2-1.3 0-2.4.5-3.3 1.2a13 13 0 0 0-6 0C8 4 7 3.5 5.7 3.5c-.6 1.2-.5 2.2-.4 3.2C4.5 7.6 4 8.7 4 10c0 4 2 5.5 6 6-1.2.3-1 1-1 2v4"/>',code:'<path d="m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16"/>',briefcase:'<rect x="3" y="7" width="18" height="14" rx="3"/><path d="M8 7V4h8v3M3 12c6 4 12 4 18 0M12 12v4"/>',graduate:'<path d="m2 9 10-5 10 5-10 5Z M6 11v6c4 3 8 3 12 0v-6M22 9v8"/>',user:'<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',layers:'<path d="m3 7 9-4 9 4-9 4ZM3 12l9 4 9-4M3 17l9 4 9-4"/>'};
---
{name==='github'?<span class="brand-mark"><img class="github-light" src={`${import.meta.env.BASE_URL}brands/github-black.svg`} width="30" height="30" alt="" aria-hidden="true"/><img class="github-dark" src={`${import.meta.env.BASE_URL}brands/github-white.svg`} width="30" height="30" alt="" aria-hidden="true"/></span>:name==='linkedin'?<img class="brand-mark linkedin-mark" src={`${import.meta.env.BASE_URL}brands/linkedin.png`} width="35" height="30" alt="" aria-hidden="true"/>:<svg class={`icon icon-${name} ${className}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]||paths.arrow}/>}
