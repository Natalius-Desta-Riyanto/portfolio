---
import Icon from './Icon.astro';
import Base from '../layouts/Base.astro';
import SelectedProjects from './SelectedProjects.astro';
import EditorialHero from './EditorialHero.astro';
import Capabilities from './Capabilities.astro';
import {editorial} from '../data/editorial';



import ProfilePortrait from './ProfilePortrait.astro';
import CvAction from './CvAction.astro';
import CampusActivities from './CampusActivities.astro';
import Experience from './Experience.astro';
import {projects,t,href,caseSections,type Locale} from '../data/site';
interface Props{locale:Locale;page?:string;slug?:string;}
const {locale,page='home',slug}=Astro.props;const c=t(locale);const e=editorial(locale);const project=projects.find(p=>p.slug===slug);
const projectPosition=projects.findIndex(p=>p.slug===slug);

const SectionHeading=page==='home'?'h2':'h1';
const path=(page==='home'||page==='404')?'':page==='case'?`work/${slug}/`:`${page}/`;
const title=project?.title||(page==='home'?undefined:page==='404'?c.notFound:page==='experience'?c.experienceMenu:page==='education'?c.education:page==='contact'?c.contact:page==='skills'?e.capabilities:c[page as 'work'|'about']);
---
<Base locale={locale} title={title} path={path}>
{page!=='case'&&page!=='404'?<>
{page==='home'&&<EditorialHero locale={locale}/>}
{(page==='about'||page==='home')&&<section id="about" class="section container about-editorial"><div class="about-portrait"><ProfilePortrait locale={locale}/></div><div class="about-story"><div class="eyebrow">01 / {c.about}</div><SectionHeading>{e.aboutTitle}</SectionHeading><p class="lead">{e.aboutText}</p><div class="about-facts"><a href={`${href(locale)}#education`}><Icon name="graduate"/><span><small>{c.education}</small><strong>{c.university}</strong></span></a><span><Icon name="pin"/><span><small>{c.basedIn}</small><strong>{c.location}</strong></span></span></div><CvAction locale={locale}/></div></section>}
{(page==='skills'||page==='home')&&<Capabilities locale={locale} embedded={page==='home'}/>}
{(page==='experience'||page==='home')&&<section id="experience" class="section container"><div class="section-heading"><div><div class="eyebrow">03 / {c.experienceMenu}</div><SectionHeading>{c.experienceMenu}</SectionHeading></div></div><Experience locale={locale}/></section>}
{(page==='education'||page==='home')&&<section id="education" class="section container"><div class="page-heading"><div class="eyebrow">04 / {c.education}</div><SectionHeading>{c.educationTitle}</SectionHeading><p class="lead">{c.educationNote}</p></div><article class="education-panel"><img class="university-logo" src={`${import.meta.env.BASE_URL}brands/universitas-indonesia.svg`} alt="Makara Universitas Indonesia" width="72" height="72" loading="lazy"/><div class="education-copy"><span class="micro">{c.educationPeriod} · {c.expectedGraduation}</span><h2>{c.university}</h2><p class="education-degree">{c.degree}</p><p class="education-faculty">{c.faculty}</p></div><CampusActivities locale={locale}/></article></section>}
{(page==='work'||page==='home')&&<section id="projects" class="section container projects-page"><div class="page-heading editorial-section-heading"><div class="eyebrow">05 / {e.indexLabel}</div><SectionHeading>{c.selected}</SectionHeading></div><SelectedProjects locale={locale} embedded={page==='home'}/></section>}
{(page==='contact'||page==='home')&&<section id="contact" class="section container contact-page"><div class="contact-heading"><div class="eyebrow">06 / {c.contact}</div><SectionHeading>{e.contactLine}</SectionHeading><p>{c.contactInvitation}</p></div><div class="contact-composition"><div class="contact-details"><div class="contact-email-block"><span class="micro icon-label"><Icon name="mail"/>{c.emailMe}</span><a class="contact-email" href="mailto:stefanusriyan26@gmail.com">stefanusriyan26@gmail.com</a></div><div class="contact-social-row"><a href="https://www.linkedin.com/in/natalius-desta-riyanto/"><Icon name="linkedin"/><span>LinkedIn</span></a><a href="https://github.com/Natalius-Desta-Riyanto"><Icon name="github"/><span>GitHub</span></a><a href="https://www.instagram.com/nataliusdesta_/"><img src={`${import.meta.env.BASE_URL}brands/instagram.svg`} alt="" width="22" height="22"/><span>Instagram</span></a></div><div class="contact-bottom-row"><p class="icon-label"><Icon name="clock"/>WIB · UTC+7</p></div></div></div><aside class="contact-brief"><h3>{c.contactTopics}</h3><ul><li><span class="focus-icon"><Icon name="code"/></span><div><strong>{c.contactProduct}</strong><small>{c.contactProductDetail}</small></div></li><li><span class="focus-icon"><Icon name="layers"/></span><div><strong>{c.contactAutomation}</strong><small>{c.contactAutomationDetail}</small></div></li><li><span class="focus-icon"><Icon name="globe"/></span><div><strong>{c.contactData}</strong><small>{c.contactDataDetail}</small></div></li></ul></aside></section>}
</>:page==='case'&&project?<div class="case-workspace" data-case-workspace>
<button class="orbit-trigger" type="button" aria-label={c.projectsMenu} aria-expanded="false" aria-controls="project-orbit" hidden data-enhance><Icon name="grid"/><span class="orbit-trigger-label">{c.projectsMenu}</span></button><aside class="project-sidebar" id="project-orbit"><nav id="project-sidebar-list" class="project-sidebar-list" aria-label={c.projectsMenu}><p class="micro sidebar-caption">{c.projectsMenu}</p><div>{projects.map((p,i)=><a style={`--project-position:${i}`} href={href(locale,`work/${p.slug}/`)} aria-current={p.slug===project.slug?'page':undefined} aria-label={p.title} title={p.title}><img src={`${import.meta.env.BASE_URL}${p.image}`} alt="" width="40" height="40"/><span class="orbit-project-copy"><small>{p.index}</small><strong>{p.title}</strong></span><span class="sidebar-active-dot" aria-hidden="true"></span></a>)}</div></nav></aside>
<article class="section container case-study" data-project={project.slug}>

<nav class="case-breadcrumb" aria-label={c.projectsMenu}><a href={`${href(locale)}#projects`}><Icon name="left"/>{({en:"Back to projects",id:"Kembali ke proyek",de:"Zurück zu Projekten",ja:"プロジェクトに戻る",zh:"返回项目"})[locale]}</a><span class="case-location">{project.title}</span></nav>
<header class="case-hero"><div class="case-intro"><div class="eyebrow">{project.index} / {c[project.category]}</div><h1>{project.title}</h1><p class="lead">{c[project.copy]}</p><div class="case-actions"><a class="button" href={project.url}>{e.tryDemo}<Icon name="play"/></a>{project.sourcePublic&&<a class="button source-button" href={project.repoUrl}><Icon name="github"/>{c.sourceProject}</a>}{!project.sourcePublic&&<span class="work-private">{c.privateSource}</span>}</div><div class="case-context"><span class="project-status">{e.statuses[projectPosition]}</span><p><strong>{e.roleLabel}</strong> · {e.contributions[projectPosition]}</p></div><ul class="stack">{project.stack.map(s=><li>{s}</li>)}</ul></div><figure class="case-preview"><div class="case-preview-bar"><span aria-hidden="true">● ● ●</span><span>{project.title}</span></div><a class="case-image-link" href={`${import.meta.env.BASE_URL}${project.image}`} target="_blank" rel="noopener" aria-label={`${project.title} — ${c.read}`}><img class="project-screenshot case-screenshot" src={`${import.meta.env.BASE_URL}${project.image}`} alt={project.title} width="1280" height="720"/><span class="image-expand"><Icon name="arrow"/></span></a></figure></header>
<div class="case-body"><div class="case-detail-tabs" aria-label={c.caseOverview}>{[c.caseOverview,c.caseFlow,c.caseFeatures,c.caseImplementation].map((heading,i)=><button type="button" id={`case-tab-${i}`} aria-controls={`case-panel-${i}`} data-case-tab={i}>{heading}</button>)}</div><div class="case-content-grid">{caseSections(locale,project.slug).map(([heading,text],i)=><section class="case-content-section" id={`case-panel-${i}`} aria-labelledby={`case-tab-${i}`}><span class="case-section-number">{String(i+1).padStart(2,'0')}</span><div><h2>{heading}</h2><p>{text}</p></div></section>)}</div>
</div></article></div>:<section class="section container page-heading"><div class="eyebrow">404</div><h1>{c.notFound}</h1><a class="button" href={href(locale)}>{c.home} ↗</a></section>}

</Base>
