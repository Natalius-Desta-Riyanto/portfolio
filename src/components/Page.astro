---
import Icon from './Icon.astro';
import Base from '../layouts/Base.astro';
import ProjectSlider from './ProjectSlider.astro';



import ProfilePortrait from './ProfilePortrait.astro';
import CvAction from './CvAction.astro';
import Experience from './Experience.astro';
import {projects,t,href,type Locale} from '../data/site';
interface Props{locale:Locale;page?:string;slug?:string;}
const {locale,page='home',slug}=Astro.props;const c=t(locale);const project=projects.find(p=>p.slug===slug);
const projectPosition=projects.findIndex(p=>p.slug===slug);
const previousProject=projects[projectPosition-1];const followingProject=projects[projectPosition+1];
const path=(page==='home'||page==='404')?'':page==='case'?`work/${slug}/`:`${page}/`;
const title=project?.title||(page==='home'?undefined:page==='404'?c.notFound:page==='experience'?c.experienceMenu:page==='education'?c.education:page==='contact'?c.contact:c[page as 'work'|'about']);
---
<Base locale={locale} title={title} path={path}>
{page!=='case'&&page!=='404'?<>
<section id="about" class="section container profile-page"><div class="about-intro"><div class="page-heading"><div class="eyebrow">{c.eyebrow}</div><h1>Natalius Desta Riyanto<span class="gradient-text">{c.profileRole}</span></h1><p class="lead">{c.profileText}</p><div class="location-chip"><Icon name="pin"/><span>{c.basedIn} <strong>{c.location}</strong></span></div><div class="actions"><a class="button" href="#projects">{c.viewProjects}<Icon name="arrow"/></a><CvAction locale={locale}/></div></div><ProfilePortrait locale={locale}/></div></section>
<section id="experience" class="section container"><div class="section-heading"><div><div class="eyebrow">02 / {c.experienceMenu}</div><h2>{c.experienceMenu}</h2></div></div><Experience locale={locale}/></section>
<section id="projects" class="section container projects-page"><div class="page-heading"><div class="eyebrow">03 / {c.projectsMenu}</div><h2>{c.selected}</h2><p class="lead">{c.selectedIntro}</p></div><ProjectSlider locale={locale}/></section>
<section id="education" class="section container"><div class="page-heading"><div class="eyebrow">04 / {c.education}</div><h2>{c.educationTitle}</h2><p class="lead">{c.educationNote}</p></div><article class="education-panel"><span class="micro">{c.educationPeriod} · {c.expectedGraduation}</span><h3>{c.university}</h3><p>{c.degree}</p><p>{c.faculty}</p><div class="education-orbit" aria-hidden="true">∑ <span>⌘</span> ∞</div></article></section>
<section id="contact" class="section container contact-page"><div class="contact-heading"><div class="eyebrow">05 / {c.contact}</div><h2>{c.contactTitle}</h2><p>{c.contactInvitation}</p></div><div class="contact-composition"><div class="contact-details"><div class="contact-email-block"><span class="micro icon-label"><Icon name="mail"/>{c.emailMe}</span><a class="contact-email" href="mailto:stefanusriyan26@gmail.com">stefanusriyan26@gmail.com<Icon name="arrow"/></a></div><div class="contact-social-row"><a href="https://www.linkedin.com/in/natalius-desta-riyanto/"><Icon name="linkedin"/><span>LinkedIn</span><Icon name="arrow"/></a><a href="https://github.com/Natalius-Desta-Riyanto"><Icon name="github"/><span>GitHub</span><Icon name="arrow"/></a><a href="https://www.instagram.com/nataliusdesta_/"><img src={`${import.meta.env.BASE_URL}brands/instagram.svg`} alt="" width="22" height="22"/><span>Instagram</span><Icon name="arrow"/></a></div><div class="contact-bottom-row"><p class="icon-label"><Icon name="clock"/>WIB · UTC+7</p></div></div><div class="contact-location"><div class="contact-location-heading"><span class="location-symbol"><Icon name="pin"/></span><div><span class="micro">{c.basedIn}</span><h3>{c.location}</h3></div></div><figure class="location-map"><iframe title={c.mapTitle} src={`${import.meta.env.BASE_URL}indonesia-map.html`} loading="lazy" referrerpolicy="no-referrer"></iframe><figcaption><span>{c.mapNote}</span></figcaption></figure></div></div><aside class="contact-brief"><h3>{c.contactTopics}</h3><ul><li><span class="focus-icon"><Icon name="code"/></span><div><strong>{c.contactProduct}</strong><small>{c.contactProductDetail}</small></div></li><li><span class="focus-icon"><Icon name="layers"/></span><div><strong>{c.contactAutomation}</strong><small>{c.contactAutomationDetail}</small></div></li><li><span class="focus-icon"><Icon name="globe"/></span><div><strong>{c.contactData}</strong><small>{c.contactDataDetail}</small></div></li></ul><p>{c.contactBrief}</p></aside></section>
</>:page==='case'&&project?<article class="section container case-study">

<header class="case-hero"><div class="case-intro"><div class="eyebrow">{project.index} / {c[project.category]}</div><h1>{project.title}</h1><p class="lead">{c[project.copy]}</p><div class="case-actions"><a class="button" href={project.url}>{c.liveProject}<Icon name="arrow"/></a>{project.category==='analytics'&&<a class="button source-button" href="https://github.com/Desta-data-analytics/credit-risk-analytics"><Icon name="github"/>{c.sourceProject}</a>}</div><ul class="stack">{project.stack.map(s=><li>{s}</li>)}</ul></div><figure class="case-preview"><div class="case-preview-bar"><span aria-hidden="true">● ● ●</span><span>{project.title}</span></div><img class="project-screenshot case-screenshot" src={`${import.meta.env.BASE_URL}${project.image}`} alt={project.title} width="1440" height="900"/></figure></header>
<div class="case-body"><div class="case-detail-tabs" aria-label={c.caseOverview}>{[c.caseOverview,c.caseFlow,c.caseFeatures,c.caseImplementation].map((heading,i)=><button type="button" id={`case-tab-${i}`} aria-controls={`case-panel-${i}`} data-case-tab={i}>{heading}</button>)}</div><div class="case-content-grid">{[[c.caseOverview,project.category==='analytics'?c.riskOverview:c.sakuaraOverview],[c.caseFlow,project.category==='analytics'?c.riskFlow:c.sakuaraFlow],[c.caseFeatures,project.category==='analytics'?c.riskFeatures:c.sakuaraFeatures],[c.caseImplementation,project.category==='analytics'?c.riskImplementation:c.sakuaraImplementation]].map(([heading,text],i)=><section class="case-content-section" id={`case-panel-${i}`} aria-labelledby={`case-tab-${i}`}><span class="case-section-number">{String(i+1).padStart(2,'0')}</span><div><h2>{heading}</h2><p>{text}</p></div></section>)}</div>
<nav class="case-pagination" aria-label={c.work}>{previousProject&&<a class="case-project-link" href={href(locale,`work/${previousProject.slug}/`)}><Icon name="left"/><img src={`${import.meta.env.BASE_URL}${previousProject.image}`} alt="" width="120" height="80"/><span><small>{c.previousProject}</small><strong>{previousProject.title}</strong></span></a>}<a class="case-all" href={href(locale,'#projects')}>{c.back}<Icon name="arrow"/></a>{followingProject&&<a class="case-project-link case-project-next" href={href(locale,`work/${followingProject.slug}/`)}><img src={`${import.meta.env.BASE_URL}${followingProject.image}`} alt="" width="120" height="80"/><span><small>{c.nextProjectLabel}</small><strong>{followingProject.title}</strong></span><Icon name="right"/></a>}</nav></div></article>:<section class="section container page-heading"><div class="eyebrow">404</div><h1>{c.notFound}</h1><a class="button" href={href(locale)}>{c.home} ↗</a></section>}

</Base>
