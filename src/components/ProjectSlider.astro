---
import Icon from './Icon.astro';
import {projects,t,href,type Locale} from '../data/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;const c=t(locale);
---
<section class="project-slider" data-carousel aria-label={c.projectsMenu}>
<div class="slider-toolbar"><span class="micro">{c.software} / {c.analytics}</span><div class="slider-controls"><button type="button" data-prev aria-label={c.previousProject} hidden data-enhance><Icon name="left"/></button><span data-slide-count aria-live="polite" aria-atomic="true">01 / {String(projects.length).padStart(2,'0')}</span><button type="button" data-next aria-label={c.nextSlide} hidden data-enhance><Icon name="right"/></button></div></div>
<div class="slider-track" data-track>{projects.map(p=><article class="project-slide" data-slide><div class="slide-art"><img class="project-screenshot" src={`${import.meta.env.BASE_URL}${p.image}`} alt={p.title} width="1440" height="900" loading="lazy"/></div><div class="slide-copy"><div class="eyebrow">{p.index} / {c[p.category]} {p.sample&&<span class="sample-badge">{c.sample}</span>}</div><h2>{p.title}</h2><p class="lead">{c[p.copy]}</p><ul class="stack">{p.stack.map(s=><li>{s}</li>)}</ul><a class="button" href={href(locale,`work/${p.slug}/`)}>{c.read}<Icon name="arrow"/></a></div></article>)}</div>
</section>
