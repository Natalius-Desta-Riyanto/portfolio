---
import Icon from './Icon.astro';
import {t,type Locale} from '../data/site';
import {profileAssets} from '../data/profile';
interface Props {locale:Locale;size?:'lg';}
const {locale,size}=Astro.props;
const c=t(locale);
---
{profileAssets.cv&&<a class:list={['btn btn-outline cv-button',{'btn-lg':size==='lg'}]} href={`${import.meta.env.BASE_URL}${profileAssets.cv}`} download><Icon name="download"/>{c.downloadCv}</a>}
