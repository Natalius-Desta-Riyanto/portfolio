---
import Icon from './Icon.astro';
import {editorial} from '../data/editorial';
import {projects,t,href,type Locale} from '../data/site';
interface Props {locale:Locale;limit?:number;embedded?:boolean;}
const {locale,limit,embedded=false}=Astro.props;
const Heading=limit||embedded?'h3':'h2';
const c=t(locale);
const e=editorial(locale);
const base=import.meta.env.BASE_URL;
const slider=embedded&&!limit;
const nav={en:['Previous projects','Next projects'],id:['Proyek sebelumnya','Proyek berikutnya'],de:['Vorherige Projekte','Nächste Projekte'],ja:['前のプロジェクト','次のプロジェクト'],zh:['上一个项目','下一个项目']}[locale];
---
<div class:list={[{'project-slider':slider}]} data-slider={slider||undefined} role={slider?'region':undefined} aria-label={slider?c.selected:undefined}>
 {slider&&<div class="slider-controls" data-enhance hidden>
  <span class="slider-count" aria-hidden="true">01 / {String(projects.length).padStart(2,'0')}</span>
  <button class="btn btn-outline btn-icon" type="button" data-slide="-1" aria-label={nav[0]}><Icon name="left"/></button>
  <button class="btn btn-outline btn-icon" type="button" data-slide="1" aria-label={nav[1]}><Icon name="right"/></button>
 </div>}
 <div class={slider?'project-track':'project-grid'}>
  {projects.slice(0,limit).map((p,i)=><article class:list={['work-card',{'work-card-featured':p.featured&&!slider}]} aria-labelledby={`project-${p.slug}`}>
   <a class="work-preview" href={href(locale,`work/${p.slug}/`)} tabindex="-1" aria-label={`${p.title} — ${c.read}`}>
    <img src={`${base}${p.image}`} alt="" width="1600" height="900" loading={i<3?'eager':'lazy'} decoding="async"/>
   </a>
   <div class="work-copy">
    <div class="work-meta">
     <span class="work-index">{p.index} · {c[p.category]}</span>
     <span class="badge">{e.statuses[i]}</span>
    </div>
    <Heading id={`project-${p.slug}`}>{p.title}</Heading>
    <p class="work-summary">{c[p.copy]}</p>
    <ul class="tag-list" aria-label={c.toolkit}>{p.stack.map(s=><li class="tag">{s}</li>)}</ul>
    <div class="work-actions">
     <a class="btn btn-sm btn-primary" href={href(locale,`work/${p.slug}/`)}>{c.read}<Icon name="right"/></a>
     <a class="btn btn-sm btn-outline" href={p.url}><Icon name="play"/>{e.tryDemo}</a>
     {p.sourcePublic?<a class="btn btn-sm btn-ghost btn-icon" href={p.repoUrl} aria-label={`GitHub: ${p.title}`} title="GitHub"><Icon name="github"/></a>:<span class="work-private" title={c.privateSource}><Icon name="lock"/><span class="sr-only">{c.privateSource}</span></span>}
    </div>
   </div>
  </article>)}
 </div>
</div>
