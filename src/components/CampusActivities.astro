---
import type {Locale} from '../data/site';
const {locale}=Astro.props as {locale:Locale};
const labels={en:['Beyond the classroom','Chair, Law & Student Democracy Commission','Second Deputy, Aksioma Department','Staff, Legal Commission','Staff, Academic Affairs Department','Staff, Events & Creative Division','Volunteering & Events'],id:['Di luar ruang kuliah','Ketua Komisi Hukum & Demokrasi Mahasiswa','Second Deputy, Aksioma Department','Staf Komisi Hukum','Staf Departemen Keilmuan','Staf Divisi Acara & Kreatif','Volunteer & Kegiatan'],de:['Engagement & Aktivitäten','Vorsitz, Kommission für Recht & studentische Demokratie','Second Deputy, Aksioma Department','Mitarbeit, Rechtskommission','Mitarbeit, akademische Abteilung','Mitarbeit, Veranstaltungen & Kreatives','Veranstaltungsteams'],ja:['リーダーシップ・課外活動','法律・学生民主主義委員会 委員長','Second Deputy, Aksioma Department','法律委員会 スタッフ','学術部門 スタッフ','イベント・クリエイティブ部門 スタッフ','運営委員会'],zh:['领导力与校园活动','法律与学生民主委员会主席','Second Deputy, Aksioma Department','法律委员会成员','学术部门成员','活动与创意部门成员','活动筹备']}[locale];
type Role={role:string;date:string};
const organizations:{name:string;roles:Role[]}[]=[
 {name:'DPM UI',roles:[{role:labels[1],date:'2025'},{role:labels[3],date:'2024'}]},
 {name:'HMDM FMIPA UI',roles:[{role:labels[2],date:'2024'}]},
 {name:'BEM FMIPA UI',roles:[{role:labels[4],date:'2024'}]},
 {name:'KMK MIPA · KMK UI',roles:[{role:labels[5],date:'2024'}]},
];
const events:{name:string;roles:Role[]}[]=[
 {name:'UI Science Olympiad',roles:[{role:'Logistics and Support Coordinator',date:'Jun — Nov 2024'}]},
 {name:'TOSKA KEMAS UI',roles:[{role:'Head of Sponsorship Division',date:'Nov 2024 — Jan 2025'}]},
];
const columns=[
 {title:({en:'Organizations',id:'Organisasi',de:'Organisationen',ja:'学生団体',zh:'学生组织'})[locale],items:organizations},
 {title:labels[6],items:events},
];
---
<details class="education-activities">
 <summary><span>{labels[0]}<small>{({en:'Organizations · Volunteering & Events',id:'Organisasi · Volunteer & Kegiatan',de:'Organisationen · Ehrenamt & Veranstaltungen',ja:'学生団体・ボランティア・イベント',zh:'学生组织 · 志愿活动'})[locale]}</small></span><span class="education-expand" aria-hidden="true"></span></summary>
 <div class="education-activities-content"><div class="education-activity-columns">
  {columns.map(({title,items})=><section>
   <h4>{title}</h4>
   <ul class="education-activity-list">
    {items.map(({name,roles})=><li class="education-activity-row">
     <h5>{name}</h5>
     {roles.map(({role,date})=><div class="education-activity-role">
      <p>{role}</p><time>{date}</time>
     </div>)}
    </li>)}
   </ul>
  </section>)}
 </div></div>
</details>
