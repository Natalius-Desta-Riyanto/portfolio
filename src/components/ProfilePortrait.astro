---
import {t,type Locale} from '../data/site';
import {profileAssets} from '../data/profile';
interface Props {locale:Locale;}
const c=t(Astro.props.locale);
---
{profileAssets.photo&&<figure class="hero-portrait about-portrait">
 <img src={`${import.meta.env.BASE_URL}${profileAssets.photo}`} alt="Natalius Desta Riyanto" width="640" height="800" loading="eager"/>
 <figcaption><strong>Natalius Desta Riyanto</strong><span>{c.profileRole}</span></figcaption>
</figure>}
