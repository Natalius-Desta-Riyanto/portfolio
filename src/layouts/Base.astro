---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {locales,labels,htmlLang,t,href,type Locale} from '../data/site';
interface Props {locale:Locale;title?:string;path?:string;}
const {locale,title,path=''}=Astro.props; const c=t(locale);
const menu=[['about',c.about],['experience',c.experienceMenu],['projects',c.projectsMenu],['education',c.education],['contact',c.contact]];
const isPortfolio=!path.startsWith('work/') || path==='work/';
const sectionHref=(id:string)=>isPortfolio?`#${id}`:`${href(locale)}#${id}`;
const canonical=Astro.site ? new URL(href(locale,path),Astro.site) : undefined;
---
<!doctype html><html lang={htmlLang[locale]} data-theme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><script is:inline>try{const value=localStorage.getItem('ndr-theme');if(value==='light'||value==='dark')document.documentElement.dataset.theme=value;}catch{}</script><title>{title ? `${title} — Natalius Desta Riyanto` : 'Natalius Desta Riyanto — Full Stack Developer & Data Analyst'}</title><meta name="description" content={c.intro}/><meta name="robots" content="index,follow"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content={title || 'Natalius Desta Riyanto'}/><meta property="og:description" content={c.intro}/><meta property="og:type" content="website"/>{Astro.site && locales.map(l=><link rel="alternate" hreflang={htmlLang[l]} href={new URL(href(l,path),Astro.site)}/> )}</head><body><div class="ambient-video" data-motion-hero><video muted loop playsinline preload="none" poster={`${import.meta.env.BASE_URL}media/tech-background.webp`} data-src={`${import.meta.env.BASE_URL}media/tech-background.webm`} aria-hidden="true" tabindex="-1"></video><div class="ambient-scrim"></div></div><button type="button" class="background-control" data-motion-toggle data-play-label={c.playBackground} data-pause-label={c.pauseBackground} aria-label={c.playBackground} title={c.playBackground} aria-pressed="false" hidden data-enhance><span data-motion-icon><span data-play-icon><Icon name="play"/></span><span data-pause-icon hidden><Icon name="pause"/></span></span></button><div class="reading-progress" aria-hidden="true"></div>
<a class="skip-link" href="#main">{c.skip}</a>
<header class="site-header container"><a class="brand" href={href(locale)} aria-label="Natalius Desta Riyanto"><span class="monogram">N.</span><span>Natalius <span class="brand-extra">Desta Riyanto</span></span></a><nav class="desktop-nav" aria-label={c.menu}>{menu.map(([p,label])=><a href={sectionHref(p)} data-section-link={p}>{label}</a>)}</nav><details class="navigation"><summary aria-label={c.menu} title={c.menu}><span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span></summary><nav aria-label={c.menu}>{menu.map(([p,label])=><a href={sectionHref(p)} data-section-link={p}>{label}</a>)}</nav></details><button type="button" class="theme-toggle" aria-label={c.themeLabel} title={c.themeLabel} hidden data-enhance><Icon name="theme"/></button><details class="language"><summary aria-label={c.language}>{labels[locale]} <Icon name="chevron"/></summary><nav aria-label={c.language}>{locales.map(l=><a href={href(l,path)} lang={htmlLang[l]} aria-current={locale===l?'true':undefined}>{labels[l]}</a>)}</nav></details></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container"><div class="footer-summary"><span class="footer-mark">N.</span><span>© {new Date().getFullYear()} Natalius Desta Riyanto</span><a class="footer-top" href={sectionHref('about')} aria-label={c.about} title={c.about}><Icon name="arrow"/></a></div></div></footer>
<script>
import '../scripts/interactions';
</script>
</body></html>
