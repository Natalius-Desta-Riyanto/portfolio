---
import '../styles/global.css';
import '../styles/curated.css';
import Icon from '../components/Icon.astro';
import {editorial} from '../data/editorial';
import {projects,locales,labels,htmlLang,t,href,type Locale} from '../data/site';
interface Props {locale:Locale;title?:string;path?:string;}
const {locale,title,path=''}=Astro.props; const c=t(locale);
const e=editorial(locale);
const skillsLabel={en:'Skills',id:'Keahlian',ja:'スキル',de:'Kenntnisse',zh:'技能'}[locale];
const homeLabel={en:'Home',id:'Beranda',ja:'ホーム',de:'Start',zh:'首页'}[locale];
const menu=[['',homeLabel],['about',c.about],['skills',skillsLabel],['experience',c.experienceMenu],['education',c.education],['work',c.projectsMenu],['contact',c.contact]];
const sections:Record<string,string>={'':'intro',about:'about',skills:'capabilities',experience:'experience',education:'education',work:'projects',contact:'contact'};
const sectionHref=(p:string)=>`${href(locale)}#${sections[p]}`;
const current=path.startsWith('work/')?'work':path.replace(/\/$/,'');
const pageTitle=title?`${title} · Natalius Desta Riyanto`:`Natalius Desta Riyanto · ${e.role}`;
const caseProject=projects.find(project=>path===`work/${project.slug}/`);
const description=path.startsWith('work/')&&title?`${title}. ${caseProject?c[caseProject.copy]:c.selectedIntro}`:current==='contact'?c.contactInvitation:current==='about'?e.aboutText:current==='skills'?e.capIntro:current==='education'?`${c.degree} · ${c.university}. ${c.educationNote}`:current==='experience'?`${c.engineeringRole} · T-NEX. ${c.engineeringText}`:e.intro;
const canonical=Astro.site ? new URL(href(locale,path),Astro.site) : undefined;
---
<!doctype html><html lang={htmlLang[locale]} data-theme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><script is:inline>try{const value=localStorage.getItem('ndr-theme');if(value==='light'||value==='dark')document.documentElement.dataset.theme=value;}catch{}</script><title>{pageTitle}</title><meta name="description" content={description}/><meta name="robots" content="index,follow"/><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-v4.svg`}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{Astro.site && <><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}social-preview.png`,Astro.site)}/><meta property="og:image:alt" content="Natalius Desta Riyanto — Full-stack Developer & Data Analyst"/></>}<meta name="twitter:card" content="summary_large_image"/>{Astro.site && locales.map(l=><link rel="alternate" hreflang={htmlLang[l]} href={new URL(href(l,path),Astro.site)}/> )}</head><body><div class="portfolio-backdrop" aria-hidden="true"></div><div class="reading-progress" aria-hidden="true"></div>
<a class="skip-link" href="#main">{c.skip}</a>
<header class="site-header container"><a class="brand" href={href(locale)} aria-label="Natalius Desta Riyanto"><span class="monogram"><img src={`${import.meta.env.BASE_URL}brands/natalius-mark.svg`} alt="" width="42" height="42"/></span><span>Natalius <span class="brand-extra">Desta Riyanto</span></span></a><nav class="desktop-nav" aria-label={c.menu}>{menu.map(([p,label])=><a href={sectionHref(p)} data-section={sections[p]} aria-current={current===p?'page':undefined}>{label}</a>)}</nav><details class="navigation"><summary aria-label={c.menu} title={c.menu}><span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span></summary><nav aria-label={c.menu}>{menu.map(([p,label])=><a href={sectionHref(p)} data-section={sections[p]} aria-current={current===p?'page':undefined}>{label}</a>)}</nav></details><button type="button" class="theme-toggle" aria-label={c.themeLabel} title={c.themeLabel} hidden data-enhance><span class="theme-switch-track"><span class="theme-switch-thumb"></span><Icon name="sun"/><Icon name="moon"/></span></button><details class="language"><summary aria-label={c.language}>{labels[locale]} <Icon name="chevron"/></summary><nav aria-label={c.language}>{locales.map(l=><a href={href(l,path)} lang={htmlLang[l]} aria-current={locale===l?'true':undefined}>{labels[l]}</a>)}</nav></details></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-line"><small>© {new Date().getFullYear()} Natalius Desta Riyanto</small><span>Depok, Indonesia · UTC+7</span></div></footer>
<script>
import '../scripts/interactions';
</script>
</body></html>
